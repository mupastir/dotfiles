{
  "permissions": {
    "deny": ["WebSearch", "WebFetch"],
    "ask": ["Bash"],
    "disableBypassPermissionsMode": "disable"
  },
  "allowManagedPermissionRulesOnly": true,
  "enabledPlugins": {
    "ralphex@ralphex": true,
    "brainstorm@umputun-cc-thingz": true,
    "review@umputun-cc-thingz": true,
    "planning@umputun-cc-thingz": true,
    "release-tools@umputun-cc-thingz": true,
    "thinking-tools@umputun-cc-thingz": true,
    "skill-eval@umputun-cc-thingz": true,
    "workflow@umputun-cc-thingz": true,
    "frontend-design@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "~/.netrc",
        "./.env",
        "~/.env",
        "~/env",
        "~/.aws/credentials",
        "~/Downloads",
        "~/Documents",
        "~/Pictures",
        "./*.p8",
        "./*.pem",
        "./*_credentials.csv"
      ],
      "allowRead": ["."]
    },
    "enableWeakerNestedSandbox": false
  },
  "alwaysThinkingEnabled": true,
  "theme": "dark",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "effortLevel": "high"
}
